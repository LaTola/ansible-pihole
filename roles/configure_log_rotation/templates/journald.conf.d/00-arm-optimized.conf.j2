# {{ ansible_managed }}
[Journal]
# 1. Store logs in RAM (tmpfs) to eliminate flash wear and IO latency
Storage={{ journalctl.storage }}

# 2. Limit RAM consumption (since volatile logs live in memory)
RuntimeMaxUse={{ journalctl.max_use }}
RuntimeMaxFileSize={{ journalctl.max_file_size }}

# 3. Disable heavy compression to save weak CPU cycles (or use LZ4 if space is tight)
Compress={{ journalctl.compress }}

# 4. Strict rate limiting to protect CPU during crash loops
RateLimitIntervalSec={{ journalctl.rate_limit.interval }}
RateLimitBurst={{ journalctl.rate_limit.burst }}

# 5. Disable unnecessary logging sources and forwarding overhead
Audit={{ journalctl.audit }}
ForwardToWall={{ journalctl.ForwardToWall }}
ForwardToSyslog={{ journalctl.ForwardToSyslog }}
