server:
    # ─── THREADING ───────────────────────────────────────────────
    # H618 quad-core Cortex-A53 — 2 threads es el sweet spot para uso doméstico
    num-threads: 2

    # Slabs deben ser potencia de 2 e igual a num-threads
    msg-cache-slabs: 2
    rrset-cache-slabs: 2
    infra-cache-slabs: 2
    key-cache-slabs: 2

    # ─── CACHÉ ───────────────────────────────────────────────────
    # Con 1GB RAM: Pi-hole + Unbound + OS ~450MB, dejamos ~150MB para Unbound
    msg-cache-size: 50m
    rrset-cache-size: 100m
    infra-cache-numhosts: 10000

    # ─── CONEXIONES ──────────────────────────────────────────────
    incoming-num-tcp: 300
    tcp-idle-timeout: 30000
    outgoing-range: 8192
    num-queries-per-thread: 4096

    # ─── DNSSEC (deshabilitado) ───────────────────────────────────
    val-log-level: 0
