# {{ ansible_managed }}
server:    
    # Cache tuning
    # Cache sizing for a 1 GB board
    # Slabs should match num-threads and stay as powers of two
    msg-cache-slabs: 2
    rrset-cache-slabs: 2
    infra-cache-slabs: 2
    key-cache-slabs: 2

    # Cache sizes tuned for Armbian
    msg-cache-size: 16m
    rrset-cache-size: 32m
    infra-cache-numhosts: 5000

    # Cache TTLs tuned to balance freshness and performance
    cache-min-ttl: 60           # Minimum TTL for cached records; keeps caching modest and freshness reasonable
    
    # Cap maximum TTL to avoid overly stale data
    cache-max-ttl: 86400        # Maximum TTL for cached records; capped at one day

    # Serve expired records while refreshing in the background
    serve-expired: yes          # Improve responsiveness at the cost of slightly stale data

    # Prefetch popular records to keep the cache warm
    prefetch: yes               # Reduce latency for frequently requested domains

    # Serve expired replies after one second
    serve-expired-client-timeout: 1000
