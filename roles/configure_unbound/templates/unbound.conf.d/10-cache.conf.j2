server:    
    # Cache Performance Tweaks
    cache-min-ttl: 300          # 5 minutes minimum (reduces upstream traffic)
    cache-max-ttl: 86400        # 1 day maximum
    serve-expired: yes          # Return expired records while fetching fresh ones
    prefetch: yes               # Refresh popular records before they expire
    prefetch-key: no            # Disable prefetching of DNSKEY records to save resources
