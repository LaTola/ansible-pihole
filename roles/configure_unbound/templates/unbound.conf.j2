# Minimal working Unbound configuration

server:
    # Listen on port 5335 to avoid conflicts with system DNS
    port: 5335

    # Listen on localhost only
    interface: lo

    # Allow queries from localhost only
    access-control: 127.0.0.1 allow
    access-control: ::1 allow

    # Prevent DNS rebinding attacks by treating LAN network as private
    private-address: {{ lan_network }}
    
    # DNS settings
    do-ip4: yes
    do-ip6: yes
    do-udp: yes
    do-tcp: yes

    # Logging
    verbosity: 1
    use-syslog: yes

# Include additional config files
include: "{{ unbound_config_dir }}/unbound.conf.d/*.conf"
