# Base Unbound configuration

server:
    # Listen on port 5335 to avoid conflicts with other DNS services
    port: 5335        # DNS listen port

    # Listen on localhost only
    interface: lo     # Bind to loopback only

    # Allow queries only from localhost
    access-control: 127.0.0.1 allow    # Allow IPv4 localhost
    access-control: ::1 allow          # Allow IPv6 localhost

    # Treat the LAN network as private for rebinding protection
    private-address: {{ lan_network }} # LAN range treated as private

    # DNS settings
    do-ip4: yes       # Enable IPv4
    do-ip6: no        # Disable IPv6
    do-udp: yes       # Enable UDP
    do-tcp: yes       # Enable TCP

    # Logging
    verbosity: 1      # Moderate logging
    use-syslog: yes   # Log to syslog

# Include additional config files
include: "{{ unbound_config_dir }}/unbound.conf.d/*.conf"  # Load modular config fragments